  elBtnInspectorObjectMenu?.setAttribute("aria-expanded", String(!elInspectorObjectMenu?.classList.contains("hidden")));
  if (elBtnDelete) elBtnDelete.disabled = !hasSelection;

  if (elBtnInspectorTogglePrint) {
